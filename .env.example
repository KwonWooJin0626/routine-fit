# Copy the dedicated Supabase project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable after custom:naver is configured in Supabase Auth.
SUPABASE_NAVER_ENABLED=false
# Server only. JSON object mapping verified Supabase user UUIDs to existing data owner IDs.
SUPABASE_LEGACY_ACCOUNT_LINKS=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional Google Vision OCR. Manual InBody entry works without this key.
GOOGLE_VISION_API_KEY=
# Optional sleep email. Web check-in works without these values.
RESEND_API_KEY=
SLEEP_EMAIL_FROM=
SLEEP_APP_URL=
SLEEP_TOKEN_SECRET=
CRON_SECRET=
# Optional YouTube video cards. Without this key, official search links work.
# Aladin OpenAPI retired on 2026-10-30; books use official bestseller links.
YOUTUBE_API_KEY=
# Enable only AFTER a minute-level scheduler is connected to /api/cron/sleep.
SLEEP_EMAIL_SCHEDULER_ENABLED=false
